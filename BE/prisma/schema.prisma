// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  staff

  @@map("user_role")
}

// username selalu huruf kecil; dijaga validator, seed, dan CHECK "users_username_lowercase" (SQL migrasi).
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdProducts Product[]
  auditLogs       AuditLog[]
  purchases       Purchase[]
  stockMovements  StockMovement[]

  @@map("users")
}

// ERD 4.11. Tambah-saja: aplikasi tidak pernah mengubah atau menghapus baris. details tanpa password, token, atau isi resep.
model AuditLog {
  id         Int      @id @default(autoincrement())
  // Null untuk aksi tanpa pengguna yang dikenali.
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(50)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   Int?     @map("entity_id")
  details    Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Nama unik tanpa membedakan huruf besar/kecil lewat indeks fungsional "categories_name_lower_key" (SQL migrasi),
// karena indeks pada lower(name) tidak bisa ditulis di schema.prisma.
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

// Satu baris = satu model barang (stok per model, PRD FR-03.2). CHECK harga >= 0 dan stok >= 0 ada di SQL migrasi.
model Product {
  id          Int      @id @default(autoincrement())
  // Dibuat database dari sequence "products_sku_seq" (ERD D-05); tidak pernah dikirim atau diubah aplikasi.
  sku         String   @unique @default(dbgenerated("('P-'::text || lpad((nextval('products_sku_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(20)
  name        String   @db.VarChar(150)
  categoryId  Int      @map("category_id")
  sellPrice   Decimal  @map("sell_price") @db.Decimal(14, 2)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(14, 2)
  // Hanya berubah bersama mutasi stok (Tahap 5 dan seterusnya); tidak ada endpoint yang mengubahnya langsung.
  stockQty    Int      @default(0) @map("stock_qty")
  // Penyimpanan foto menunggu P-12; kolom disiapkan sesuai ERD 4.4, belum diisi aplikasi.
  photoPath   String?  @map("photo_path") @db.VarChar(255)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

// ERD 4.5. Tidak dihapus permanen bila sudah dipakai pembelian; dinonaktifkan lewat is_active.
model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  address   String?  @db.VarChar(255)
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchases Purchase[]

  @@index([isActive])
  @@map("suppliers")
}

// ERD 4.8. Tidak ada pembatalan pembelian (PRD FR-06.5); koreksi lewat retur atau opname.
// doc_number ERD belum dibuat karena format nomor dokumen menunggu P-09. CHECK total >= 0 ada di SQL migrasi.
model Purchase {
  id                Int      @id @default(autoincrement())
  supplierId        Int      @map("supplier_id")
  supplierInvoiceNo String?  @map("supplier_invoice_no") @db.VarChar(50)
  purchasedAt       DateTime @default(now()) @map("purchased_at") @db.Timestamptz(3)
  total             Decimal  @db.Decimal(14, 2)
  notes             String?
  createdById       Int      @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@index([supplierId])
  @@index([purchasedAt])
  @@map("purchases")
}

// unit_cost adalah snapshot harga beli saat pembelian (PRD FR-06.3). CHECK jumlah dan line_total ada di SQL migrasi.
model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int      @map("purchase_id")
  productId  Int      @map("product_id")
  quantity   Int
  unitCost   Decimal  @map("unit_cost") @db.Decimal(14, 2)
  lineTotal  Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, productId])
  @@index([productId])
  @@map("purchase_items")
}

// Nilai lain (sale_out, sale_void_in, purchase_return_out, opname_adjustment; ERD 4.1) ditambahkan bersama fiturnya.
enum MovementType {
  purchase_in

  @@map("movement_type")
}

// Ledger stok (ERD 4.9, DEC-012). Tambah-saja; setiap perubahan products.stock_qty punya satu baris di sini.
// CHECK sumber/jenis/tanda dan stock_after >= 0 ada di SQL migrasi.
model StockMovement {
  id             Int          @id @default(autoincrement())
  productId      Int          @map("product_id")
  movementType   MovementType @map("movement_type")
  quantityChange Int          @map("quantity_change")
  stockAfter     Int          @map("stock_after")
  purchaseId     Int?         @map("purchase_id")
  note           String?
  createdById    Int          @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([purchaseId])
  @@map("stock_movements")
}
