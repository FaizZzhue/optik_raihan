# Salin ke .env (development) dan isi nilainya. Jangan commit .env.
NODE_ENV=development
PORT=4000
# Format: postgresql://USER:PASSWORD@HOST:5432/NAMA_DATABASE
DATABASE_URL=
# String acak minimal 32 karakter, mis. hasil: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Origin aplikasi di browser. Development lewat proxy Vite: http://localhost:5173
APP_ORIGIN=

# Hanya untuk `npx prisma db seed` (owner awal). Password minimal 12 karakter.
# Hapus dari .env setelah seed dijalankan, dan ganti password owner sebelum produksi.
SEED_OWNER_USERNAME=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=

# Test memakai file terpisah .env.test (juga tidak di-commit) dengan variabel NODE_ENV, DATABASE_URL,
# JWT_SECRET, dan APP_ORIGIN. DATABASE_URL di .env.test wajib menunjuk database terpisah berakhiran _test.
