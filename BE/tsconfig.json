{
  // Dipakai untuk typecheck seluruh kode BE (src, test, file konfigurasi).
  // Build ke dist/ memakai tsconfig.build.json.
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "prisma/seed.ts", "prisma7.config.ts", "vitest.config.ts"]
}
